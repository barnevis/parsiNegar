{
  "name": "parsinegar.ui",
  "version": "0.1.0",
  "architecture": "0.11",
  "description": "Parsinegar application UI built with pey.webui",
  "dependencies": {
    "required": [
      "pey.router.service"
    ],
    "optional": []
  },
  "events": [
    {
      "name": "ui:component-error",
      "description": "A component render or event handler failed and was contained by PeyElement",
      "data": [
        {
          "name": "componentTag",
          "type": "string"
        },
        {
          "name": "code",
          "type": "string"
        }
      ]
    }
  ],
  "config": {
    "theme": "system",
    "language": "fa",
    "direction": "rtl",
    "fallbackPath": "/",
    "assetBaseUrl": "./assets"
  }
}
